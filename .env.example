# =============================================================================
# Headpress Storefront Starter: environment variables
#
# Copy to .env.local. `npm run demo` needs none of these: it starts the mock
# WordPress and points the storefront at it.
# =============================================================================

# --- Public (reach the browser; baked in at build time) ---------------------

# WordPress site URL, without a trailing slash.
NEXT_PUBLIC_WP_URL=http://127.0.0.1:8787

# This storefront's public URL (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Headpress publishable key (hp_pk_...). Needed when the store requires one.
NEXT_PUBLIC_HEADPRESS_PUBLISHABLE_KEY=

# Interface language: en, pt-BR or es.
NEXT_PUBLIC_STORE_LOCALE=en

# --- Server only (never prefix these with NEXT_PUBLIC_) ---------------------

# Headpress secret key (hp_sk_...). Used by the auth BFF to forward the
# shopper's IP, so rate limits apply per shopper and not to this server.
HEADPRESS_SECRET_KEY=

# Secret of the Headpress revalidation webhook. Without it, /api/revalidate
# refuses every delivery.
HEADPRESS_WEBHOOK_SECRET=
